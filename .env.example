# Supabase (project: gpdooxexzkrmxiwbhwfd)
SUPABASE_URL=https://gpdooxexzkrmxiwbhwfd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by scripts/runMigrations.ts
# (Supabase dashboard -> Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=

# Odds API (https://the-odds-api.com) - free tier
ODDS_API_KEY=
ODDS_API_SPORT_KEY=soccer_fifa_world_cup
# Cost is (markets x regions) per successful call - keep this to 1 region to conserve quota
ODDS_API_REGIONS=eu

# Tavily search (https://tavily.com) - free tier
TAVILY_API_KEY=

# Google Gemini (https://aistudio.google.com) - free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=

# Scheduler heartbeat (cheap - just checks whether a background sync/results-check is due)
POLL_INTERVAL_CRON=*/5 * * * *

# Background odds sync cadence (keeps match schedule/odds reasonably fresh; conserves the free
# Odds API monthly quota - the daily analysis job also syncs immediately before analyzing)
SLOW_SYNC_INTERVAL_MINUTES=720

# Post-match results check (independent cadence)
RESULTS_CHECK_INTERVAL_MINUTES=360

# Daily full-analysis batch: one consolidated message per day covering every match in the next
# 24h, generated via a single Gemini call (not one call per match) to conserve free-tier quota.
DAILY_ANALYSIS_CRON=0 17 * * *
DAILY_ANALYSIS_TIMEZONE=Asia/Jerusalem
BATCH_DEDUPE_HOURS=20

# Read-only web dashboard (optional - leave blank to disable)
DASHBOARD_PORT=3000
