{
  "name": "worldcup-prediction-platform",
  "version": "0.1.0",
  "private": true,
  "description": "2026 FIFA World Cup prediction & Telegram alert platform",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "migrate": "tsx scripts/runMigrations.ts",
    "run:analysis": "tsx scripts/runDailyAnalysis.ts",
    "run:results": "tsx scripts/runResultsCheck.ts",
    "run:sync": "tsx scripts/runOddsSync.ts",
    "dashboard": "tsx scripts/runDashboard.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "node-cron": "^3.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "pg": "^8.12.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
